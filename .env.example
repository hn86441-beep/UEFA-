# هذا ملف توضيحي فقط - لا يُستخدم فعليًا على Vercel.
# القيم الحقيقية تُضاف من: مشروعك في Vercel → Settings → Environment Variables
# (وليس هنا، ولا داخل الكود، حتى تبقى سرية ولا تظهر في المستودع العام على GitHub)

# كلمة سر لوحة التحكم - إلزامية، لا توجد قيمة افتراضية.
# بدون تعيينها، سيرفض الموقع تسجيل الدخول تمامًا (هذا مقصود، لحمايتك).
ADMIN_PASSWORD=

# سر توقيع الجلسة - إلزامي أيضًا. اكتب أي نص عشوائي طويل (20 حرفًا فأكثر).
SESSION_SECRET=

# تُنشأ مجانًا من upstash.com مباشرة (وليس عبر Vercel Marketplace) - انسخها كما هي بالضبط.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
